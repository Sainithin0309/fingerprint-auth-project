/*
 * PEUAP-W3: Privacy-Enhanced Biometric Authentication for Web 3.0
 * Scyther SPDL formal verification specification.
 *
 * Signed terms {m}sk(X) model the authenticated channels of the
 * deployment: enclave attestation at the device, TLS between client and
 * backend and relays, and the Ed25519 issuer signature on the
 * W3C Verifiable Credential.
 */

hashfunction h;

secret cred: Function;      /* biometric credential, device-resident */

/* ---------- Protocol 1: ZKP biometric authentication ---------- */
protocol PEUAPZKPAuth(D, B)
{
    role D
    {
        fresh blinding: Nonce;
        fresh sn:       Nonce;
        var   otp:      Nonce;

        send_1( D, B, { { h(cred(D), blinding), sn, D, B }sk(D) }pk(B) );
        recv_2( B, D, { { otp, sn, h(cred(D), blinding), B, D }sk(B) }pk(D) );
        send_3( D, B, { { otp, D, B }sk(D) }pk(B) );

        claim( D, Secret, cred(D) );
        claim( D, Alive );
        claim( D, Weakagree );
        claim( D, Niagree );
        claim( D, Nisynch );
    }

    role B
    {
        var comm: Ticket;
        var sn:   Nonce;
        fresh otp: Nonce;

        recv_1( D, B, { { comm, sn, D, B }sk(D) }pk(B) );
        send_2( B, D, { { otp, sn, comm, B, D }sk(B) }pk(D) );
        recv_3( D, B, { { otp, D, B }sk(D) }pk(B) );

        claim( B, Alive );
        claim( B, Weakagree );
        claim( B, Niagree );
        claim( B, Nisynch );
    }
}

/* The Shamir relay layer is deliberately not modelled here. Its guarantee
 * is threshold anonymity, which is information-theoretic (Theorem 3) rather
 * than a symbolic authentication property, and is therefore outside the
 * class of properties a Dolev-Yao model checker decides.
 */

/* ---------- Protocol 3: Verifiable Credential lifecycle ---------- */
protocol PEUAPVC(I, V)
{
    role I
    {
        fresh vcid: Nonce;
        var   ph:   Nonce;

        recv_1( V, I, { ph, V, I }sk(V) );
        send_2( I, V, { vcid, ph, I, V }sk(I) );
        recv_3( V, I, { vcid, V, I }sk(V) );

        claim( I, Alive );
        claim( I, Weakagree );
        claim( I, Niagree );
        claim( I, Nisynch );
    }

    role V
    {
        fresh ph:   Nonce;
        var   vcid: Nonce;

        send_1( V, I, { ph, V, I }sk(V) );
        recv_2( I, V, { vcid, ph, I, V }sk(I) );
        send_3( V, I, { vcid, V, I }sk(V) );

        claim( V, Alive );
        claim( V, Weakagree );
        claim( V, Niagree );
        claim( V, Nisynch );
    }
}
